---
interface Props {
  title: string;
  tagline: string;
  href: string;
  external?: boolean;
  status?: 'live' | 'in-progress';
}

const { title, tagline, href, external = false, status = 'live' } = Astro.props;
---

<a
  href={href}
  class="group block bg-ink-raised border border-ink-line p-8 hover:border-champagne/60 transition-colors"
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  <h3 class="font-display text-2xl text-paper">
    {title}{status === 'in-progress' && <span class="ml-3 text-[0.65rem] uppercase tracking-[0.25em] text-champagne border border-champagne/40 px-2 py-0.5 align-middle">In development</span>}
  </h3>
  <p class="mt-3 text-mist">{tagline}</p>
  <p class="mt-6 text-champagne">View →</p>
</a>
