---
const year = new Date().getFullYear();
---

<footer class="border-t border-ink-line bg-ink">
  <div class="mx-auto max-w-6xl px-6 py-12 grid gap-8 md:grid-cols-3">
    <div>
      <p class="font-display tracking-[0.35em] text-champagne text-base">FESQ</p>
      <p class="mt-2 text-xs text-mist">Less, built well.</p>
    </div>
    <div class="flex items-start gap-6 md:justify-center text-sm">
      <a href="https://github.com/festum" aria-label="GitHub" class="text-mist hover:text-champagne transition-colors"><i class="fa-brands fa-github" aria-hidden="true"></i></a>
      <a href="https://x.com/festum" aria-label="X" class="text-mist hover:text-champagne transition-colors"><i class="fa-brands fa-x-twitter" aria-hidden="true"></i></a>
      <a href="https://fesqin.t.me" aria-label="Telegram" class="text-mist hover:text-champagne transition-colors"><i class="fa-brands fa-telegram" aria-hidden="true"></i></a>
    </div>
    <div class="text-xs text-mist md:text-right">
      <p>© {year} Fesq. All rights reserved. · <a href="/products/font-rendering-enhancer/privacy" class="whitespace-nowrap hover:text-champagne transition-colors">Privacy Policy</a></p>
    </div>
  </div>
</footer>
